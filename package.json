{
  "name": "ai_agent",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "team": "bun run src/team.ts",
    "typecheck": "tsc --noEmit",
    "eval:memory": "bun run benchmarks/memory_recall_eval.ts",
    "eval:scanner": "bun run benchmarks/scanner_eval.ts",
    "trace:report": "bun run benchmarks/trace_report.ts",
    "test:memory": "bun test tests/memory_store.test.ts tests/memory_recall.test.ts tests/memory_writer.test.ts tests/memory_recall_eval.test.ts tests/context_compression.test.ts",
    "test:scanner": "bun test tests/scanner_registry.test.ts tests/scanner_eval.test.ts tests/bili_snapshot.test.ts tests/bili_collect.test.ts",
    "fmt": "bun fmt src/",
    "skill:add": "bunx skills add",
    "rag:ingest": "bun run src/rag/ingest.ts",
    "rag:cases": "bun run src/rag/ingest_cases.ts",
    "rag:prune": "bun run src/rag/prune_corpus.ts",
    "rag:bench": "bun run src/rag/bench_index.ts",
    "rag:migrate-pg": "bun run src/rag/migrate_to_pg.ts",
    "test:rag": "bun run tests/rag.test.ts && bun run tests/rag_ingest.test.ts && bun run tests/rag_ranking.test.ts && bun run tests/rag_vector.test.ts && bun run tests/rag_pg.test.ts",
    "test": "bun  test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@tavily/core": "^0.7.12",
    "gpt-tokenizer": "^4.0.0",
    "hyparquet": "^1.31.3",
    "openai": "^7.15.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.5"
  }
}
